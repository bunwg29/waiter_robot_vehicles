<?xml version="1.0"?>
<!-- ================================================================
  Waiter Robot URDF – Multi-part service robot design
  - Base platform (wide, low) with 4 wheels
  - Central column/pillar
  - Serving tray at table height (~0.72 m)
  - 2D LiDAR on top
================================================================ -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="waiter_robot">

  <!-- ===================== PROPERTIES ===================== -->
  <!-- Wheels -->
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width"  value="0.03"/>
  <xacro:property name="wheel_mass"   value="0.5"/>
  <xacro:property name="wheel_x"      value="0.13"/>
  <xacro:property name="wheel_y"      value="0.19"/>

  <!-- Base platform (where wheels attach) -->
  <xacro:property name="base_radius"  value="0.22"/>
  <xacro:property name="base_height"  value="0.06"/>
  <xacro:property name="base_mass"    value="8.0"/>

  <!-- Central column -->
  <xacro:property name="col_radius"   value="0.06"/>
  <xacro:property name="col_height"   value="0.58"/>
  <xacro:property name="col_mass"     value="3.0"/>

  <!-- Serving tray -->
  <xacro:property name="tray_radius"  value="0.18"/>
  <xacro:property name="tray_height"  value="0.025"/>
  <xacro:property name="tray_mass"    value="1.0"/>

  <!-- LiDAR -->
  <xacro:property name="lidar_radius" value="0.035"/>
  <xacro:property name="lidar_height" value="0.03"/>

  <!-- ===================== MACROS ========================= -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(1.0/12.0)*m*(3*r*r + h*h)}" ixy="0" ixz="0"
               iyy="${(1.0/12.0)*m*(3*r*r + h*h)}" iyz="0"
               izz="${0.5*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <!-- Wheel macro -->
  <xacro:macro name="wheel" params="prefix x_pos y_pos">
    <link name="${prefix}_wheel_link">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="dark_grey"><color rgba="0.15 0.15 0.15 1"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
          </friction>
        </surface>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${prefix}_wheel_link"/>
      <!-- Wheels at axle height (z=0 in base_link frame = wheel_radius above ground) -->
      <origin xyz="${x_pos} ${y_pos} 0" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.01" friction="0.1"/>
    </joint>
  </xacro:macro>

  <!-- ===================== LINKS ========================== -->
  <!-- Ground-level reference -->
  <link name="base_footprint"/>

  <!-- Base platform – wide flat disk at wheel axle height -->
  <link name="base_link">
    <visual>
      <geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry>
      <material name="charcoal"><color rgba="0.25 0.25 0.28 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="${base_mass}" r="${base_radius}" h="${base_height}"/>
  </link>

  <!-- base_footprint → base_link: lift so wheel bottoms touch ground -->
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- Central column/pillar -->
  <link name="column_link">
    <visual>
      <geometry><cylinder radius="${col_radius}" length="${col_height}"/></geometry>
      <material name="silver"><color rgba="0.7 0.7 0.72 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="${col_radius}" length="${col_height}"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="${col_mass}" r="${col_radius}" h="${col_height}"/>
  </link>

  <joint name="column_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="column_link"/>
    <origin xyz="0 0 ${base_height/2 + col_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- Serving tray -->
  <link name="tray_link">
    <visual>
      <geometry><cylinder radius="${tray_radius}" length="${tray_height}"/></geometry>
      <material name="orange"><color rgba="0.9 0.5 0.1 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="${tray_radius}" length="${tray_height}"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="${tray_mass}" r="${tray_radius}" h="${tray_height}"/>
  </link>

  <joint name="tray_joint" type="fixed">
    <parent link="column_link"/>
    <child  link="tray_link"/>
    <origin xyz="0 0 ${col_height/2 + tray_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- LiDAR sensor on top of tray -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
      <material name="blue"><color rgba="0.1 0.1 0.8 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="tray_link"/>
    <child  link="lidar_link"/>
    <origin xyz="0 0 ${tray_height/2 + lidar_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== WHEELS ========================= -->
  <xacro:wheel prefix="front_left"  x_pos="${wheel_x}"  y_pos="${wheel_y}"/>
  <xacro:wheel prefix="front_right" x_pos="${wheel_x}"  y_pos="${-wheel_y}"/>
  <xacro:wheel prefix="rear_left"   x_pos="${-wheel_x}" y_pos="${wheel_y}"/>
  <xacro:wheel prefix="rear_right"  x_pos="${-wheel_x}" y_pos="${-wheel_y}"/>

  <!-- ===================== GAZEBO PLUGINS ================= -->
  <!-- Differential drive – 4 wheels -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${2.0 * wheel_y}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <!-- TF disabled – odom_tf_broadcaster handles it -->
      <tf_topic>__unused_tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <max_linear_acceleration>0.5</max_linear_acceleration>
      <max_angular_acceleration>1.0</max_angular_acceleration>
    </plugin>
  </gazebo>

  <!-- Joint state publisher for wheel visualization -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>
  </gazebo>

  <!-- 2D LiDAR sensor (360°, 6m range) -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>6.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

</robot>
