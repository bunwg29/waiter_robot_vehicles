<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="waiter_robot">

  <!-- Robot dimensions -->
  <xacro:property name="base_radius" value="0.23"/>
  <xacro:property name="base_height" value="0.28"/>
  <xacro:property name="base_mass" value="22.0"/>

  <xacro:property name="wheel_radius" value="0.08"/>
  <xacro:property name="wheel_width" value="0.045"/>
  <xacro:property name="wheel_mass" value="1.2"/>
  <xacro:property name="wheel_y_offset" value="0.245"/>

  <xacro:property name="caster_radius" value="0.035"/>
  <xacro:property name="caster_mass" value="0.35"/>

  <xacro:property name="lidar_radius" value="0.05"/>
  <xacro:property name="lidar_height" value="0.06"/>
  <xacro:property name="lidar_mass" value="0.25"/>

  <xacro:macro name="inertial_cylinder" params="mass radius length">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="${(1.0/12.0) * mass * (3.0 * radius * radius + length * length)}"
               ixy="0.0"
               ixz="0.0"
               iyy="${(1.0/12.0) * mass * (3.0 * radius * radius + length * length)}"
               iyz="0.0"
               izz="${0.5 * mass * radius * radius}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="inertial_sphere" params="mass radius">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="${0.4 * mass * radius * radius}"
               ixy="0.0"
               ixz="0.0"
               iyy="${0.4 * mass * radius * radius}"
               iyz="0.0"
               izz="${0.4 * mass * radius * radius}"/>
    </inertial>
  </xacro:macro>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${wheel_radius + base_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_height}"/>
      </geometry>
      <material name="body_gray">
        <color rgba="0.25 0.25 0.28 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 ${wheel_radius + base_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_height}"/>
      </geometry>
    </collision>

    <xacro:inertial_cylinder mass="${base_mass}" radius="${base_radius}" length="${base_height}"/>
  </link>

  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.08 0.08 0.08 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>

    <xacro:inertial_cylinder mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}"/>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 ${wheel_y_offset} ${wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>

    <xacro:inertial_cylinder mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}"/>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -${wheel_y_offset} ${wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="caster_silver">
        <color rgba="0.75 0.75 0.78 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>

    <xacro:inertial_sphere mass="${caster_mass}" radius="${caster_radius}"/>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="-${base_radius * 0.70} 0 ${caster_radius}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="lidar_blue">
        <color rgba="0.1 0.45 0.75 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>

    <xacro:inertial_cylinder mass="${lidar_mass}" radius="${lidar_radius}" length="${lidar_height}"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${base_height + lidar_height / 2.0}" rpy="0 0 0"/>
  </joint>

  <link name="torso_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.42"/>
      </geometry>
      <material name="torso_white">
        <color rgba="0.92 0.92 0.94 1.0"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0.15 0 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.20 0.22"/>
      </geometry>
      <material name="front_screen">
        <color rgba="0.14 0.18 0.22 1.0"/>
      </material>
    </visual>
    <xacro:inertial_cylinder mass="2.8" radius="0.18" length="0.42"/>
  </link>

  <joint name="torso_joint" type="fixed">
    <parent link="base_link"/>
    <child link="torso_link"/>
    <origin xyz="0 0 ${base_height + 0.21}" rpy="0 0 0"/>
  </joint>

  <link name="tray_lower_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.22" length="0.03"/>
      </geometry>
      <material name="tray_dark">
        <color rgba="0.2 0.2 0.22 1.0"/>
      </material>
    </visual>
    <xacro:inertial_cylinder mass="0.6" radius="0.22" length="0.03"/>
  </link>

  <joint name="tray_lower_joint" type="fixed">
    <parent link="torso_link"/>
    <child link="tray_lower_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

  <link name="tray_upper_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.23" length="0.03"/>
      </geometry>
      <material name="tray_dark_2">
        <color rgba="0.22 0.22 0.25 1.0"/>
      </material>
    </visual>
    <xacro:inertial_cylinder mass="0.6" radius="0.23" length="0.03"/>
  </link>

  <joint name="tray_upper_joint" type="fixed">
    <parent link="torso_link"/>
    <child link="tray_upper_link"/>
    <origin xyz="0 0 0.24" rpy="0 0 0"/>
  </joint>

  <link name="head_cap_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.12"/>
      </geometry>
      <material name="head_white">
        <color rgba="0.93 0.93 0.95 1.0"/>
      </material>
    </visual>
    <xacro:inertial_sphere mass="0.8" radius="0.12"/>
  </link>

  <joint name="head_cap_joint" type="fixed">
    <parent link="torso_link"/>
    <child link="head_cap_link"/>
    <origin xyz="0 0 0.31" rpy="0 0 0"/>
  </joint>

  <!-- Wheel-ground friction and contact tuning for stable turns in Gazebo -->
  <gazebo reference="left_wheel_link">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="caster_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="lidar_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${2.0 * wheel_y_offset}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>cmd_vel_nav</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
    </plugin>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor type="gpu_lidar" name="waiter_lidar_sensor">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>12.0</update_rate>
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.008</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>

</robot>
