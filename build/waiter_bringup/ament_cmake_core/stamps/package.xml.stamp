<?xml version="1.0"?>
<package format="3">
  <name>waiter_bringup</name>
  <version>0.0.1</version>
  <description>Top-level bringup launch files for the waiter robot project.</description>

  <maintainer email="student@example.com">waiter_robot_team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>waiter_simulation</exec_depend>
  <exec_depend>waiter_navigation</exec_depend>
  <exec_depend>waiter_tasks</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
