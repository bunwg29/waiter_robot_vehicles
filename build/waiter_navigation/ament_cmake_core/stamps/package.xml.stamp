<?xml version="1.0"?>
<package format="3">
  <name>waiter_navigation</name>
  <version>0.0.1</version>
  <description>Navigation stack configuration for the waiter robot.</description>

  <maintainer email="student@example.com">waiter_robot_team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_dwb_controller</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>waiter_description</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
